{
  "name": "backend",
  "version": "1.0.0",
  "description": "Prisma, TypeScript, Swagger & tsoa Backend",
  "main": "dist/server.js",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "prebuild": "prisma generate && tsoa spec-and-routes",
    "build": "tsc",
    "start": "node dist/server.js",
    "predev": "prisma generate && tsoa spec-and-routes",
    "dev": "nodemon --watch src --ext ts --ignore src/generated/prisma --exec tsx src/server.ts",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "render-build": "npm install && npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.2",
    "@types/pg": "^8.23.1",
    "@types/swagger-ui-express": "^4.1.6",
    "nodemon": "^3.1.0",
    "prisma": "^5.14.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.9.3",
    "@prisma/adapter-neon": "^5.14.0",
    "@prisma/adapter-pg": "5.22.0",
    "@prisma/client": "^5.14.0",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^18.0.4",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "swagger-ui-express": "^5.0.0",
    "tsoa": "^6.4.0"
  }
}
